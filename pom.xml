<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>net.skykings</groupId>
  <artifactId>skykings-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>SkyKings Parent</name>
  <description>
    Maven-Monorepo-Parent fuer die SkyKings-Plugins (OP-SkyPvP, 1.8.9-Client / 1.8.8-Legacy-Serverstack).
    Phase 0 gemaess docs/ROADMAP.md: nur Projektstruktur und Buildsystem, keine Gameplay-Features.
  </description>

  <modules>
    <module>plugins/SkyKings-Core</module>
    <module>plugins/SkyKings-Combat</module>
    <module>plugins/SkyKings-Crates</module>
    <module>plugins/SkyKings-Admin</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!--
      WICHTIG (siehe Auftrag / CLAUDE.md Punkt 8+13): Es wurde bewusst KEINE moderne
      Java-Version eigenmaechtig festgelegt. 1.8 ist der langjaehrige Standardwert fuer
      Spigot/Paper-1.8.8-Legacy-Plugins und damit die konservativste, nicht-moderne Wahl.
      Dies ist NICHT final - siehe docs/LOCAL_DEVELOPMENT.md, Abschnitt "Offene Punkte",
      zur Verifikation gegen die lokal tatsaechlich installierten JDKs.
    -->
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>

    <skykings.spigot.version>1.8.8-R0.1-SNAPSHOT</skykings.spigot.version>
  </properties>

  <repositories>
    <!--
      Die Spigot-API ist nicht auf Maven Central verfuegbar. Offizieller Weg ist
      BuildTools.jar (siehe tools/README.md). Dieses Repository ist der von SpigotMC
      dokumentierte Zusatzweg, spigot-api direkt zu beziehen, FALLS das lokale Netzwerk
      Zugriff erlaubt - siehe docs/LOCAL_DEVELOPMENT.md fuer den bekannten Blocker in
      der Cloud-Build-Umgebung dieser Session.
    -->
    <repository>
      <id>spigotmc-repo</id>
      <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
    </repository>
  </repositories>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.spigotmc</groupId>
        <artifactId>spigot-api</artifactId>
        <version>${skykings.spigot.version}</version>
        <scope>provided</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <source>${maven.compiler.source}</source>
            <target>${maven.compiler.target}</target>
            <encoding>${project.build.sourceEncoding}</encoding>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
