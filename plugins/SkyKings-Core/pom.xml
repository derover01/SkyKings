<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>net.skykings</groupId>
    <artifactId>skykings-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>SkyKings-Core</artifactId>
  <packaging>jar</packaging>
  <name>SkyKings-Core</name>
  <description>
    Zentrales SkyKings-Modul (siehe docs/ARCHITECTURE.md): Player-Profile, Rank-/Economy-API,
    Kit-Registry und Cooldown-Basis, zentrale Configs, gemeinsame GUI-/Item-Utilities,
    Datenpersistenz, Events/API fuer die anderen SkyKings-Module.
    Phase 0: nur Plugin-Grundgeruest, keine Features implementiert.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.spigotmc</groupId>
      <artifactId>spigot-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <!-- Test-only (nicht im Plugin-JAR enthalten), beeinflusst die 1.8.8-Legacy-
           Laufzeitkompatibilitaet nicht. Pinned auf die letzte JUnit-4-Version. -->
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- NUR fuer Tests auf der Build-Maschine: SQLiteDataStore ruft zur Laufzeit auf dem
           echten Server org.sqlite.JDBC aus dem Spigot-1.8.8-JAR (Version 3.7.2) auf, das
           ist HIER nicht auf dem Classpath. Diese moderne Testversion beeinflusst die
           Produktionslaufzeit nicht, sie verifiziert nur, dass unser SQL (bewusst kein
           Upsert, siehe SQLiteDataStore) gegen eine echte SQLite-Engine funktioniert. -->
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.45.1.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Test-only: einziger Zweck ist ein leichtgewichtiges Interface-Mock fuer
           org.bukkit.entity.Player (kein volles MockBukkit/Server-Mock noetig), um den
           defensiven Kick-Pfad in PlayerLifecycleListener#onJoin zu testen. Letzte
           Java-8-kompatible Mockito-4.x-Version. -->
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>4.11.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
