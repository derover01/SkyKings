<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>net.skykings</groupId>
    <artifactId>skykings-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>SkyKings-Core</artifactId>
  <packaging>jar</packaging>
  <name>SkyKings-Core</name>
  <description>
    Zentrales SkyKings-Modul (siehe docs/ARCHITECTURE.md): Player-Profile, Rank-/Economy-API,
    Kit-Registry und Cooldown-Basis, zentrale Configs, gemeinsame GUI-/Item-Utilities,
    Datenpersistenz, Events/API fuer die anderen SkyKings-Module.
    Phase 0: nur Plugin-Grundgeruest, keine Features implementiert.
  </description>

  <repositories>
    <repository>
      <!-- Wird ausschliesslich fuer die VaultUnlockedAPI-Compile-Abhaengigkeit benoetigt
           (siehe Phase-1B-Abschlussbericht). Nicht auf Maven Central verfuegbar. -->
      <id>codemc-creatorfromhell</id>
      <url>https://repo.codemc.io/repository/creatorfromhell/</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>org.spigotmc</groupId>
      <artifactId>spigot-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <!-- Nur zum Kompilieren gegen die LuckPerms-API (Interfaces, keine Implementierung).
           Version 5.4 passt zur eingesetzten Legacy-Java-8-Plugin-Version LuckPerms-Bukkit
           5.4.145 (LuckPerms versioniert die API-Artefakte nach Minor-Version). Wird NICHT
           in das Plugin-JAR eingebunden - zur Laufzeit stellt das echte LuckPerms-Plugin die
           Implementierung bereit; ist es nicht installiert, wird die Bridge-Klasse gar nicht
           erst geladen (siehe LuckPermsPermissionBridge). -->
      <groupId>net.luckperms</groupId>
      <artifactId>api</artifactId>
      <version>5.4</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <!-- Nur zum Kompilieren gegen die klassische net.milkbowl.vault.economy-API (von
           VaultUnlocked beibehalten). Version 2.20 passt zur eingesetzten Legacy-Java-8-
           Plugin-Version VaultUnlockedJava8-2.20.2 (VaultUnlockedAPI versioniert nach
           Major.Minor). Wird NICHT in das Plugin-JAR eingebunden. -->
      <groupId>net.milkbowl.vault</groupId>
      <artifactId>VaultUnlockedAPI</artifactId>
      <version>2.20</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <!-- Test-only (nicht im Plugin-JAR enthalten), beeinflusst die 1.8.8-Legacy-
           Laufzeitkompatibilitaet nicht. Pinned auf die letzte JUnit-4-Version. -->
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- NUR fuer Tests auf der Build-Maschine: SQLiteDataStore ruft zur Laufzeit auf dem
           echten Server org.sqlite.JDBC aus dem Spigot-1.8.8-JAR (Version 3.7.2) auf, das
           ist HIER nicht auf dem Classpath. Diese moderne Testversion beeinflusst die
           Produktionslaufzeit nicht, sie verifiziert nur, dass unser SQL (bewusst kein
           Upsert, siehe SQLiteDataStore) gegen eine echte SQLite-Engine funktioniert. -->
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.45.1.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Test-only: mockt Bukkit-API-Typen wie Player/Inventory/InventoryClickEvent, ohne ein
           volles MockBukkit/Server-Mock zu benoetigen. "inline" statt "core" ist noetig, weil
           mehrere Bukkit-Event-Getter final sind (z. B. PlayerEvent#getPlayer(),
           InventoryCloseEvent#getPlayer()) - der Standard-Mockmaker kann finale Methoden nicht
           abfangen. Letzte Java-8-kompatible Mockito-4.x-Version. -->
      <groupId>org.mockito</groupId>
      <artifactId>mockito-inline</artifactId>
      <version>4.11.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
